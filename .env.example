# ================= Supabase =================
# من: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# المفتاح العام (anon) — يُستخدم في المتصفح لرفع المرفقات برابط موقّع فقط
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# مفتاح service_role — سرّي، يُستخدم على الخادم فقط ولا يُنشر أبداً
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ================= الجلسات =================
# سلسلة عشوائية طويلة (٣٢ حرفاً فأكثر) لتوقيع جلسات الموظفين
# لتوليدها: openssl rand -base64 48
SESSION_SECRET=

# ================= البريد الإلكتروني =================
# مفتاح Resend لإرسال الإشعارات ورموز OTP.
# إذا تُرك فارغاً يعمل النظام لكن تُطبع الرسائل في سجل الخادم بدل إرسالها.
RESEND_API_KEY=
MAIL_FROM=بلدية السويق <no-reply@example.com>

# ================= التطبيق =================
NEXT_PUBLIC_APP_URL=http://localhost:3000
